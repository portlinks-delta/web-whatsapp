# Copy this file to .env and adjust as needed. Every value is optional.

# Port the Socket.IO backend listens on. Defaults to 5001 when unset.
# The frontend must use the same port through REACT_APP_SERVER_PORT.
SERVER_PORT=5001

# Optional. MongoDB connection string for RemoteAuth session storage.
# Without it, sessions are stored locally in .wwebjs_auth.
# MONGO_URI=

# Optional. Full path to a Chrome/Chromium executable.
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
